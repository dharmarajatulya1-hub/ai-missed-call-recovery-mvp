# ============================================
# Twilio Configuration (Phase 1)
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Supabase Configuration (Phase 2)
# ============================================
# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key (has full access, bypasses RLS)
# ⚠️ NEVER expose this in client-side code
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2OTk5OTk5OTksImV4cCI6MjAxNTU3NTk5OX0.xxx

# Anonymous key (respects RLS, safe for client-side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjk5OTk5OTk5LCJleHAiOjIwMTU1NzU5OTl9.xxx

# ============================================
# Cal.com OAuth2 Configuration (Phase 2)
# ============================================
# Get these from: https://app.cal.com/settings/developer

# OAuth Client ID (starts with cal_live_ in production)
CALCOM_CLIENT_ID=cal_live_xxxxxxxxxxxxxxxxxxxxxxxx

# OAuth Client Secret (starts with cal_secret_)
# ⚠️ Keep this secret - never commit to git
CALCOM_CLIENT_SECRET=cal_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# OAuth Redirect URI (must match Cal.com app settings exactly)
# Development: http://localhost:3000/api/calcom/oauth
# Production: https://your-domain.vercel.app/api/calcom/oauth
CALCOM_REDIRECT_URI=https://your-domain.vercel.app/api/calcom/oauth

# ============================================
# VAPI Configuration
# ============================================
# If you need to make outbound calls or manage assistants
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-default-assistant-id

# Shared secret verifying inbound VAPI webhook events (x-vapi-secret header).
# Set the SAME value in the VAPI dashboard Server URL settings.
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# Public base URL of this deployment (no trailing slash), used to build the
# per-assistant server webhook URL. Example: https://your-domain.vercel.app
PUBLIC_BASE_URL=https://your-domain.vercel.app

# ============================================
# Debug Endpoints
# ============================================
# Required to access /api/debug/prompt-preview (fails closed if unset)
DEBUG_SECRET=your-debug-secret

# ============================================
# Optional: API Security
# ============================================
# Add this if you want to protect your API endpoints
# API_KEY=your-secret-api-key

# ============================================
# Daily Digest Email (MVP)
# ============================================
# Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address verified in Resend
EMAIL_FROM="AI Missed Call <no-reply@yourdomain.com>"

# Secret used by Vercel Cron to call the digest endpoint
CRON_SECRET=your-cron-secret

# Dashboard base URL (used in emails)
DASHBOARD_URL=https://your-dashboard-domain.com

# ============================================
# Optional: Monitoring & Logging
# ============================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOGTAIL_TOKEN=xxx
# DATADOG_API_KEY=xxx

# ============================================
# Development Notes
# ============================================
# 1. Copy this file to .env.local for local development
# 2. Set these in Vercel Dashboard for production
# 3. Never commit .env.local to git (.gitignore should block it)
# 4. Rotate secrets regularly (especially after team changes)
